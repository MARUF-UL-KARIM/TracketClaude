precision highp float;

uniform sampler2D uSrc;
uniform sampler2D uMask;

varying vec2 vSrcTexCoord;
varying vec2 vMaskTexCoord;

// 0.0 = read mask from R channel
// 1.0 = read mask from A channel
uniform float uMaskUseAlpha;

// Expand / shrink control:
//   0.0  = original contour (around 0.5)
//  >0.0  = expand mask
//  <0.0  = shrink mask
// Typically something in range [-0.25 .. +0.25]
uniform float uExpand;

// Feather (soft edge) width:
// 0.0 = hard edge
// Larger value = softer edge
uniform float uFeather;

// Region selection:
// >0.5 = keep INSIDE mask (foreground)
// ≤0.5 = keep OUTSIDE mask (background)
uniform float uKeepInside;


// Reads preprocessed SDF-style mask value (0..1).
// ~0.5 = original contour edge.
float readMaskValue(vec2 uv) {
    vec4 m = texture2D(uMask, uv);

    // Select R or A channel using uMaskUseAlpha
    float v = mix(m.r, m.a, clamp(uMaskUseAlpha, 0.0, 1.0));
    return v;
}


void main() {
    vec4 src = texture2D(uSrc, vSrcTexCoord);

    // Mask value: 0..1 (generated by SDF preprocessing)
    float m = readMaskValue(vMaskTexCoord);

    // Base threshold around original contour = 0.5
    float cutoff = 0.5 + uExpand;
    cutoff = clamp(cutoff, 0.0, 1.0);

    float feather = max(uFeather, 0.0);

    float insideMask;

    // Hard edge
    if (feather < 0.0001) {
        insideMask = step(cutoff, m);   // m >= cutoff → inside
    }
    // Soft edge transition
    else {
        float halfW = feather * 0.5;
        float edge0 = cutoff - halfW;
        float edge1 = cutoff + halfW;
        insideMask = smoothstep(edge0, edge1, m);
    }

    // Select region: inside or outside
    float regionMask = insideMask;

    // Keep outside region (inverse mask)
    if (uKeepInside <= 0.5) {
        regionMask = 1.0 - insideMask;
    }

    float outA   = src.a * regionMask;
    float outRGB = regionMask;

    gl_FragColor = vec4(src.rgb * outRGB, outA);
}