<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PostSplash" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
    </style>
    <style name="Splash" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="postSplashScreenTheme">@style/PostSplash</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="windowSplashScreenBackground">@color/background</item>
    </style>
</resources>
